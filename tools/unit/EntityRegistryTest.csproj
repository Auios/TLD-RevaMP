<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup><OutputType>Exe</OutputType><TargetFramework>net10.0</TargetFramework><Nullable>disable</Nullable><EnableDefaultCompileItems>false</EnableDefaultCompileItems></PropertyGroup>
  <ItemGroup>
    <Compile Include="../../src/TLDRevamp/Diagnostics/QuietErrors.cs" />
    <Compile Include="EntityRegistryTest.cs" />
    <Compile Include="EntityRegistryStubs.cs" />
    <Compile Include="../../src/TLDRevamp/Net/NetBuffer.cs" />
    <Compile Include="../../src/TLDRevamp/Net/FarBoltIndex.cs" />
    <Compile Include="../../src/TLDRevamp/Net/HitchAuthority.cs" />
    <Compile Include="../../src/TLDRevamp/Net/Entities.OwnerChange.cs" />
  </ItemGroup>
  <Target Name="ExtractRegistry" BeforeTargets="CoreCompile">
    <PropertyGroup>
      <PythonExecutable Condition="'$(PythonExecutable)' == '' And '$(OS)' == 'Windows_NT'">py -3</PythonExecutable>
      <PythonExecutable Condition="'$(PythonExecutable)' == ''">python3</PythonExecutable>
    </PropertyGroup>
    <Exec Command="$(PythonExecutable) -I &quot;$(MSBuildThisFileDirectory)ExtractEntityRegistry.py&quot; &quot;$(IntermediateOutputPath)Registry.g.cs&quot;" />
    <ItemGroup><Compile Include="$(IntermediateOutputPath)Registry.g.cs" /></ItemGroup>
  </Target>
  <ItemGroup>
    <Compile Include="../../src/TLDRevamp/Net/Entities.InUse.cs" />
    <Compile Include="EntityInUseUnusedLookups.cs" />
  </ItemGroup>
</Project>
