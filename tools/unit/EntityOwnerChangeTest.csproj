<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup><OutputType>Exe</OutputType><TargetFramework>net10.0</TargetFramework><Nullable>disable</Nullable><EnableDefaultCompileItems>false</EnableDefaultCompileItems><NoWarn>CS0649;CS0414;CS0169;CS8981</NoWarn></PropertyGroup>
  <PropertyGroup Condition="'$(OwnerChangeBaseline)' == '--baseline'"><DefineConstants>$(DefineConstants);OWNER_BASELINE</DefineConstants></PropertyGroup>
  <ItemGroup>
    <Compile Include="EntityOwnerChangeChecks.cs" />
    <Compile Include="EntityOwnerChangeStubs.cs" />
    <Compile Include="../../src/TLDRevamp/Net/NetBuffer.cs" />
    <Compile Include="../../src/TLDRevamp/Net/Entities.RotCodec.cs" />
    <Reference Include="Microsoft.CodeAnalysis"><HintPath>$(MSBuildToolsPath)/Roslyn/bincore/Microsoft.CodeAnalysis.dll</HintPath></Reference>
    <Reference Include="Microsoft.CodeAnalysis.CSharp"><HintPath>$(MSBuildToolsPath)/Roslyn/bincore/Microsoft.CodeAnalysis.CSharp.dll</HintPath></Reference>
  </ItemGroup>
  <Target Name="ExtractOwnerChange" BeforeTargets="CoreCompile">
    <PropertyGroup>
      <PythonExecutable Condition="'$(PythonExecutable)' == '' And '$(OS)' == 'Windows_NT'">py -3</PythonExecutable>
      <PythonExecutable Condition="'$(PythonExecutable)' == ''">python3</PythonExecutable>
    </PropertyGroup>
    <Exec Command="$(PythonExecutable) -I &quot;$(MSBuildThisFileDirectory)ExtractEntityOwnerChange.py&quot; &quot;$(IntermediateOutputPath)EntityOwnerChange.g.cs&quot; $(OwnerChangeBaseline)" />
    <ItemGroup><Compile Include="$(IntermediateOutputPath)EntityOwnerChange.g.cs" /></ItemGroup>
  </Target>
</Project>
