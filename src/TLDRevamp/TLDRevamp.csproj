<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>TLDRevamp</AssemblyName>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
      <!-- no build-machine paths in the DLL (the PDB path and source paths carry the user name) -->
    <PathMap>$(MSBuildProjectDirectory)=/src/$(MSBuildProjectName)</PathMap>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="$(MSBuildThisFileDirectory)../../lib/*.dll" Private="false" />
    <ProjectReference Include="../TLDRevamp.Multiplayer/TLDRevamp.Multiplayer.csproj" Private="false" />
    <ProjectReference Include="../TLDRevamp.Preloader/TLDRevamp.Preloader.csproj" ReferenceOutputAssembly="false" />
    <!-- FSR 3.1's compute shaders, built for the game's Unity by tools/fsr3bundle (Fixes/FsrNativeAa.cs) -->
    <EmbeddedResource Include="Assets/Fsr3Upscaler.bundle" LogicalName="TLDRevamp.Fsr3Upscaler.bundle" />
  </ItemGroup>
</Project>
